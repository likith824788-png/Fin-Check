rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to manage users, companies, documents, facts, and findings
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /documents/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /financial_facts/{factId} {
      allow read, write: if request.auth != null;
    }

    // Default catch-all for authenticated auditors
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

