# FINCHECK AI - Backend Environment Template

# 1. NVIDIA Nemotron - Primary Extraction Model
NEMOTRON_API_KEY=your_nvidia_api_key_here
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# 2. Gemma - Secondary Verification Model
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=google/gemma-4-31b-it

# 3. Groq - Fast AI Auditor Reasoning
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Firebase Configuration (Optional - fallback to unified local store if empty)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----\n"

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
